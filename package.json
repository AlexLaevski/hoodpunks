{
  "name": "hoodpunks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.js --network robinhood",
    "contracts:deploy:testnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "contracts:set-metadata-uris": "hardhat run scripts/setMetadataUris.js --network robinhood",
    "contracts:set-metadata-uris:testnet": "hardhat run scripts/setMetadataUris.js --network robinhoodTestnet",
    "contracts:open-mint": "hardhat run scripts/setPublicMintOpen.js --network robinhood",
    "contracts:open-mint:testnet": "hardhat run scripts/setPublicMintOpen.js --network robinhoodTestnet",
    "launch:check": "hardhat run scripts/launch-check.js --network robinhood",
    "launch:check:testnet": "hardhat run scripts/launch-check.js --network robinhoodTestnet",
    "launch": "npm run contracts:deploy && npm run contracts:set-metadata-uris && npm run contracts:open-mint",
    "launch:testnet": "npm run contracts:deploy:testnet && npm run contracts:set-metadata-uris:testnet && npm run contracts:open-mint:testnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "framer-motion": "^12.38.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.48.11",
    "wagmi": "^3.6.13"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "hardhat": "^2.22.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
